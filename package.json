{
  "name": "vr-learning-content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Content pipeline for the pre-primary VR learning programme.",
  "scripts": {
    "content:std": "node tools/standardise/models.js",
    "content:find": "node --env-file=.env tools/fetch/find.js",
    "content:place": "node tools/build/place.js",
    "content:textures": "node tools/standardise/textures.js",
    "content:hdri": "node tools/standardise/hdri.js",
    "content:fonts": "node tools/build/fonts.js && npm run content:letters",
    "content:library": "node tools/build/library.js",
    "content:credits": "node tools/build/credits.js",
    "content:check": "node tools/check/lessons.js",
    "content:build": "npm run content:fonts && npm run content:translations && npm run content:audio-names && npm run content:library && npm run content:credits && npm run content:lessons && npm run content:check && npm run content:status",
    "serve": "node tools/serve.js",
    "content:lessons": "node tools/build/lessons.js",
    "content:audio-names": "node tools/build/audio-names.js",
    "content:narration": "node tools/build/narration.js",
    "content:retakes": "node tools/build/retakes.js",
    "content:translations": "node tools/build/translations.js",
    "content:timing": "node tools/build/step-timing.js",
    "content:status": "node tools/build/status.js",
    "content:objects": "node tools/build/object-report.js",
    "content:letters": "node tools/build/letters.js",
    "content:browse": "node tools/check/browser/lessons.js",
    "content:classroom": "node tools/check/browser/classroom.js",
    "content:sheets": "node tools/check/browser/sheets.js",
    "content:around": "node tools/check/browser/around.js",
    "content:live": "node tools/check/browser/live.js"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "msdf-bmfont-xml": "^2.8.0",
    "playwright-core": "^1.63.0"
  }
}
