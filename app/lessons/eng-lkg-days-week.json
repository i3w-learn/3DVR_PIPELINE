    {
      "at": "mon",
      "duration": 7000,
      "script": {
        "hi": "हफ़्ते में सात दिन होते हैं। पहला दिन सोमवार।",
        "en": "There are seven days in a week. The first is Monday.",
        "mr": "आठवड्यात सात दिवस असतात. पहिला सोमवार.",
        "or": "ସପ୍ତାହରେ ସାତ ଦିନ ଥାଏ। ପ୍ରଥମ ଦିନ ସୋମବାର।"
      },
      "audio": "eng-lkg-days-week-s01.mp3"
    },
    {
      "at": "tue",
      "duration": 5000,
      "script": {
        "hi": "मंगलवार।",
        "en": "After Monday comes Tuesday.",
        "mr": "सोमवारनंतर मंगळवार येतो.",
        "or": "ସୋମବାର ପରେ ମଙ୍ଗଳବାର ଆସେ।"
      },
      "audio": "eng-lkg-days-week-s02.mp3"
    },
    {
      "at": "wed",
      "duration": 5000,
      "script": {
        "hi": "बुधवार।",
        "en": "After Tuesday comes Wednesday.",
        "mr": "मंगळवारनंतर बुधवार येतो.",
        "or": "ମଙ୍ଗଳବାର ପରେ ବୁଧବାର ଆସେ।"
